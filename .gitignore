# OS
.DS_Store
dist/
dist-browser/
node_modules/

# Dependencies
node_modules/

# Python
__pycache__/
*.pyc

# Development backups and iteration snapshots
*.bak*
*.candidate

# One-off fix/debug scripts
fix_*.py
loop_out.txt

# Test artifacts
*.bloat_test*
*.cpx_test*
*.perpatch*

# Run output (scenarios, audit logs). `runs/*` (not `runs/`) so the
# negations below can re-include specific children — per gitignore
# semantics, a child is only re-includable if its parent isn't itself
# pattern-excluded as a directory.
runs/*
!runs/adversarial-scenarios.json
!runs/baseline-history/
!runs/baseline-history/**
!runs/compiled-configs/
!runs/compiled-configs/**
!runs/baselines/
!runs/baselines/**
!runs/benchmarks/
!runs/benchmarks/**

# Compiled test sources (from tsconfig.test.json; .ts is source of truth)
test/**/*.test.js
!test/audit.test.js
!test/browser-bundle-syntax.test.js
!test/browser-parity.test.js
!test/replay-regression.test.js
!test/replay-regression-v2.test.js
!test/scenarios-unique-ids.test.js

# Addition #18: tsconfig.test.json includes tools/calibrate.ts so
# `fastMCD` can be imported from unit tests. The resulting
# tools/calibrate.js is a build artifact; source of truth is the .ts.
tools/*.js

# W4 §4.0 T1 pool-path fixture — regenerated by test/pool-path.test.ts.
test/fixtures/pool-baseline-sparse/

# Claude Code session config (per-session local state; not for the repo)
.claude/

# TypeScript incremental compile markers (regenerated; build artifact)
*.tsbuildinfo
