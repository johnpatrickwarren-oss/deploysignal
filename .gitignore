# OS
.DS_Store
dist/
dist-browser/
node_modules/

# Dependencies
node_modules/

# Python
__pycache__/
*.pyc

# Development backups and iteration snapshots
*.bak*
*.candidate

# One-off fix/debug scripts
fix_*.py
loop_out.txt

# Test artifacts
*.bloat_test*
*.cpx_test*
*.perpatch*

# Run output (scenarios, audit logs). `runs/*` (not `runs/`) so the
# negations below can re-include specific children — per gitignore
# semantics, a child is only re-includable if its parent isn't itself
# pattern-excluded as a directory.
runs/*
!runs/adversarial-scenarios.json
!runs/baseline-history/
!runs/baseline-history/**
!runs/compiled-configs/
!runs/compiled-configs/**
!runs/baselines/
!runs/baselines/**
!runs/benchmarks/
!runs/benchmarks/**

# Compiled test sources (from tsconfig.test.json; .ts is source of truth)
test/**/*.test.js
!test/audit.test.js
!test/browser-bundle-syntax.test.js
!test/browser-parity.test.js
!test/replay-regression.test.js
!test/replay-regression-v2.test.js
!test/scenarios-unique-ids.test.js

# Addition #18: tsconfig.test.json includes tools/calibrate.ts so
# `fastMCD` can be imported from unit tests. The resulting
# tools/calibrate.js is a build artifact; source of truth is the .ts.
tools/*.js
# Demo-overhaul Phase 2: pure-JS proxy that lets demos/demo.html call
# api.anthropic.com without exposing the key to the browser. No .ts
# counterpart — this is a source file, not a build artifact.
!tools/claude-proxy.js
# Anvil (Addition #29 / Q29 SLICE 2) chaos-verdict walkthrough CLI.
# Pure-JS source (no .ts counterpart); composes the engine + audit
# writer to produce demos/anvil-chaos-walkthrough.json.
!tools/demo-anvil.js
# Decomposed submodules of the tracked pure-JS build scripts build-report-card.js
# and build-canned-demos.js (split to satisfy the <500-line architectural gate).
# Source files, not build artifacts — no .ts counterpart.
!tools/_build-report-card-*.js
!tools/_build-canned-demos-*.js

# W4 §4.0 T1 pool-path fixture — regenerated by test/pool-path.test.ts.
test/fixtures/pool-baseline-sparse/

# Claude Code session config (per-session local state; not for the repo)
.claude/

# TypeScript incremental compile markers (regenerated; build artifact)
*.tsbuildinfo

# Compiled .js from the engine/advisory/calibrator .ts sources. Like the
# tools/*.js rule above, .ts is the source of truth; tsc emits these into
# the source tree (tsconfig.test.json) and they should not be committed.
# (Verified: every untracked .js here has a .ts sibling — no pure-JS sources.)
engine/**/*.js
advisory/**/*.js
tools/calibrators/*.js
# ...but keep the .js that are intentionally committed (a browser bundle and
# two calibrator modules already in the tree; preserves current tracked state).
!engine/index.browser.js
!tools/calibrators/family-a.js
!tools/calibrators/family-c.js

# Scratch compiled-config outputs from local calibration runs (the tracked
# v1–v9a configs are the intentional fixtures; test-* and *-parity-run* are throwaway
# outputs regenerated by the parity regression tests, ~16MB each).
runs/compiled-configs/test-*.json
runs/compiled-configs/*-parity-run*.json
