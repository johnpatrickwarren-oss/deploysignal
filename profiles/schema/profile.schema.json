{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deploysignal.dev/schemas/profile.schema.json",
  "title": "WorkloadProfile",
  "description": "Reference workload profile per ARCHITECT-REPLY-51 Addition #28. Parameterizes CompiledConfig inputs by workload class. Validation runs at profile/override load time in tools/profile-loader.ts.",
  "type": "object",
  "required": [
    "id",
    "version",
    "description",
    "sli_list",
    "structural_detectors",
    "joint_vector",
    "alpha_allocation",
    "cell_dimensions",
    "bake_profiles",
    "policy_defaults"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
      "description": "Profile identifier. Lowercase kebab-case; matches filename stem."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semver per D5. Format MAJOR.MINOR.PATCH."
    },
    "extends": {
      "type": ["string", "null"],
      "description": "Parent profile id (single-parent inheritance per D4). `null` for root profiles. Circular chains rejected at load time."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sli_list": {
      "type": "array",
      "description": "Family A monitored signals. Array replaces parent entirely on override (per D4 array semantics).",
      "items": {
        "type": "object",
        "required": ["signal", "direction_of_better", "δ_min"],
        "additionalProperties": false,
        "properties": {
          "signal": { "type": "string", "minLength": 1 },
          "direction_of_better": { "enum": ["higher", "lower"] },
          "δ_min": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Per-signal detection magnitude (fractional; e.g., 0.01 = 1% relative shift)."
          }
        }
      }
    },
    "structural_detectors": {
      "type": "object",
      "required": ["enabled", "dependencies"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["detector_id", "required_for"],
            "additionalProperties": false,
            "properties": {
              "detector_id": { "type": "string" },
              "required_for": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "joint_vector": {
      "type": "object",
      "required": ["signals", "include_in_family_c", "include_in_family_e"],
      "additionalProperties": false,
      "properties": {
        "signals": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Subset of sli_list.signal values."
        },
        "include_in_family_c": { "type": "boolean" },
        "include_in_family_e": { "type": "boolean" }
      }
    },
    "alpha_allocation": {
      "type": "object",
      "required": ["per_family", "total"],
      "additionalProperties": false,
      "properties": {
        "per_family": {
          "type": "object",
          "required": ["A", "B", "C", "D", "E"],
          "additionalProperties": false,
          "properties": {
            "A": { "type": "number", "minimum": 0 },
            "B": { "type": "number", "minimum": 0 },
            "C": { "type": "number", "minimum": 0 },
            "D": { "type": "number", "minimum": 0 },
            "E": { "type": "number", "minimum": 0 }
          }
        },
        "total": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Must equal per_family.A + .B + .C + .D + .E (loader enforces the invariant)."
        }
      }
    },
    "cell_dimensions": {
      "type": "object",
      "required": [
        "hour_of_day", "day_of_week", "workload_class", "tenant_tier", "region"
      ],
      "additionalProperties": false,
      "properties": {
        "hour_of_day": { "type": "boolean" },
        "day_of_week": { "type": "boolean" },
        "workload_class": { "type": "boolean" },
        "tenant_tier": { "type": "boolean" },
        "region": { "type": "boolean" }
      }
    },
    "bake_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signal", "min_ticks_before_eligible",
          "min_observation_window", "max_deploy_window_days"
        ],
        "additionalProperties": false,
        "properties": {
          "signal": { "type": "string" },
          "min_ticks_before_eligible": { "type": "integer", "minimum": 0 },
          "min_observation_window": { "type": "integer", "minimum": 0 },
          "max_deploy_window_days": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "policy_defaults": {
      "type": "object",
      "required": [
        "reversibility_threshold_minutes",
        "auto_rollback_enabled",
        "default_risk_tier"
      ],
      "additionalProperties": false,
      "properties": {
        "reversibility_threshold_minutes": {
          "type": "number",
          "minimum": 0
        },
        "auto_rollback_enabled": { "type": "boolean" },
        "default_risk_tier": { "enum": ["low", "medium", "high"] }
      }
    },
    "expected_failure_pattern_defaults": {
      "type": "object",
      "description": "Anvil (Addition #29) — profile-level defaults for ExpectedFailurePattern, applied when a chaos adapter does not supply per-experiment overrides. Optional; absent → no profile-level defaults; the chaos adapter must supply the full pattern per experiment.",
      "additionalProperties": false,
      "properties": {
        "default_suppress_families": {
          "type": "array",
          "items": { "enum": ["A", "B", "C", "D", "E"] },
          "description": "Detector families suppressed by default during chaos fault windows when no per-experiment override is provided."
        },
        "default_recovery_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Default recovery window in seconds; adapter may override per experiment."
        },
        "default_magnitude_unit": {
          "enum": ["relative_fraction", "absolute", "sigma"],
          "description": "Default unit for ExpectedFailurePattern.magnitude."
        }
      }
    }
  }
}
